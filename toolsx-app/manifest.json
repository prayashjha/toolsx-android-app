{
  "name": "ToolsX – All Tools",
  "short_name": "ToolsX",
  "description": "All-in-one free toolkit with browser-based tools for image, audio, video, developer, SEO, finance, and productivity. No signup. Works offline.",
  "start_url": ".",
  "scope": ".",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "orientation": "portrait",
  "background_color": "#f5f6fa",
  "theme_color": "#4f46e5",
  "lang": "en",
  "dir": "ltr",
  "categories": ["utilities", "productivity", "business"],
  "id": "/toolsx-app/",

  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512-maskable.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],

  "screenshots": [
    { "src": "screenshot-1.png", "sizes": "600x804", "type": "image/png", "form_factor": "narrow", "label": "ToolsX Home – browse all tools" },
    { "src": "screenshot-2.png", "sizes": "600x804", "type": "image/png", "form_factor": "narrow", "label": "Smart Text Analyser" },
    { "src": "screenshot-3.png", "sizes": "600x804", "type": "image/png", "form_factor": "narrow", "label": "AI Photo Effects Studio" },
    { "src": "screenshot-4.png", "sizes": "600x804", "type": "image/png", "form_factor": "narrow", "label": "Audio & Music tools" },
    { "src": "screenshot-5.png", "sizes": "600x804", "type": "image/png", "form_factor": "narrow", "label": "Developer tools" }
  ],

  "shortcuts": [
    {
      "name": "GST Invoice",
      "short_name": "GST",
      "description": "Create free GST invoices",
      "url": "tools/gst-invoice-generator-for-business.html",
      "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Resume Builder",
      "short_name": "Resume",
      "description": "Build ATS-friendly resume",
      "url": "tools/banayein-free-ai-resume-online-live.html",
      "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "QR Code Generator",
      "short_name": "QR Code",
      "description": "Generate QR codes with logo",
      "url": "tools/qr-code-generator-instagram-whatsapp.html",
      "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Image Compressor",
      "short_name": "Compress",
      "description": "Compress images online",
      "url": "tools/compress-karein-image-size-online-free.html",
      "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Audio Editor",
      "short_name": "Audio Editor",
      "description": "Trim, mix & export audio",
      "url": "tools/audio-editor.html",
      "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }]
    }
  ],

  "share_target": {
    "action": "share.html",
    "method": "GET",
    "enctype": "application/x-www-form-urlencoded",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },

  "file_handlers": [
    {
      "action": "tools/image-to-text-converter-online-free.html",
      "accept": {
        "image/*": [".png", ".jpg", ".jpeg", ".webp", ".gif"]
      }
    },
    {
      "action": "tools/free-pdf-tools-online-compress-merge.html",
      "accept": {
        "application/pdf": [".pdf"]
      }
    }
  ],

  "launch_handler": {
    "client_mode": "navigate-existing"
  },

  "prefer_related_applications": false,

  "related_applications": [
    {
      "platform": "play",
      "id": "in.toolsx.app"
    }
  ]
}
